generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Team {
  id          String       @id @default(uuid())
  name        String
  players     TeamPlayer[]
  tournaments TournamentTeam[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TeamPlayer {
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId Int
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  role     String   @default("PLAYER") // e.g., "CAPTAIN", "EDITOR", "PLAYER"
  status   String   @default("PENDING") // e.g., "PENDING", "ACCEPTED"
  joinedAt DateTime @default(now())

  @@id([teamId, playerId])
}

model Tournament {
  id          String   @id @default(uuid())
  name        String
  acronym     String?
  format      String   @default("4v4")
  gameMode    String   @default("osu") // osu | taiko | fruits | mania
  rosterSize  Int      @default(8)
  isCompleted Boolean  @default(false)
  stages      Stage[]
  teams       TournamentTeam[]
  keepers     TournamentKeeper[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TournamentKeeper {
  tournamentId String
  playerId     Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([tournamentId, playerId])
}

model TournamentTeam {
  tournamentId String
  teamId       String
  placement    String?

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([tournamentId, teamId])
}

model Stage {
  id           String       @id @default(uuid())
  name         String       // e.g., "Qualifiers", "Round of 32"
  sortOrder    Int          @default(0)
  tournamentId String
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  maps         MappoolMap[]
  createdAt    DateTime     @default(now())
}

model MappoolMap {
  id          String   @id @default(uuid())
  mapId       String   // e.g., "NM1", "HD1"
  mod         String   // e.g., "NM", "HD"
  artist      String
  songName    String
  skill       String?
  beatmapId   Int?     // For osu! api fetching later
  beatmapsetId Int?    // For osu!direct download links
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  scores      Score[]
  createdAt   DateTime @default(now())
}

model Player {
  id        Int      @id // osu! user id
  username  String
  avatarUrl String?
  isPublicProfile Boolean @default(true)
  teams     TeamPlayer[]
  scores    Score[]
  notifications Notification[]
  tournamentsKept TournamentKeeper[]
  trophies  PlayerTrophy[]
  createdAt DateTime @default(now())
}

model PlayerTrophy {
  id           String   @id @default(uuid())
  playerId     Int
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  trophyKey    String
  scopeId      String   @default("lifetime")
  metadata     Json?
  earnedAt     DateTime @default(now())

  @@unique([playerId, trophyKey, scopeId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    Int
  user      Player   @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO") // INFO, TEAM_INVITE
  teamId    String?
  createdAt DateTime @default(now())
}
model Feedback {
  id        String   @id @default(uuid())
  type      String
  message   String
  username  String?
  playerId  Int?
  hasImage  Boolean  @default(false)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Score {
  id           String     @id @default(uuid())
  score        Int
  accuracy     Float
  timestamp    DateTime   @default(now())
  scoreType    String     @default("PRACTICE") // PRACTICE, LOBBY, MATCH, QUALIFIER_1, QUALIFIER_2, etc.
  playedMod    String?    // e.g., "NM", "HD", "HR", "EZ"
  playerId     Int
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  mappoolMapId String
  mappoolMap   MappoolMap @relation(fields: [mappoolMapId], references: [id], onDelete: Cascade)
  isFc         Boolean    @default(false)
}
